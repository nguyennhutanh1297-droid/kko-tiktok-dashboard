# TikTok Developer App credentials
# Get from: https://developers.tiktok.com/
TIKTOK_CLIENT_KEY=your_client_key_here
TIKTOK_CLIENT_SECRET=your_client_secret_here

# OAuth redirect URI (must match what you registered in TikTok Developer Portal)
# For local dev: http://localhost:8501
TIKTOK_REDIRECT_URI=http://localhost:8501
